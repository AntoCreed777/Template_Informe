% === Ejemplos de referencia para biblatex ===

% Ejemplo de libro
@book{knuth1984,
  author    = {Donald E. Knuth},
  title     = {The TeXbook},
  year      = {1984},
  publisher = {Addison-Wesley}
}

% Ejemplo de recurso web
@online{latexweb,
  author  = {{Overleaf}},
  title   = {Documentación de Overleaf},
  year    = {2025},
  url     = {https://www.overleaf.com/learn},
  urldate = {2026-04-25}
}

% Ejemplo de repositorio en GitHub
@online{githubRepo,
  author  = {{Nombre del autor o equipo}},
  title   = {Título del proyecto o repositorio},
  year    = {2026},
  url     = {https://github.com/usuario/repositorio},
  urldate = {2026-04-25}
}

% Ejemplo de informe técnico
@techreport{techreport2021,
  author      = {Autor del informe},
  title       = {Título del informe técnico},
  institution = {Institución},
  year        = {2021},
  number      = {TR-2021-01},
  type        = {Informe técnico}
}

% Ejemplo de tesis
% Si es de maestria usar @mastersthesis
@phdthesis{phdthesis2022,
  author      = {Autor de la tesis},
  title       = {Título de la tesis},
  school      = {Universidad},
  year        = {2022},
  type        = {Tesis doctoral}
}

% Puedes eliminar estas entradas o reemplazarlas.